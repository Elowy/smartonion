"value": 1
}, {
"kind": "counter_at_least",
"counter": "wins:paladin:normal",
"value": 1
}, {
"kind": "counter_at_least",
"counter": "wins:rogue:normal",
"value": 1
}, {
"kind": "counter_at_least",
"counter": "wins:warlock:normal",
"value": 1
}, {
"kind": "counter_at_least",
"counter": "wins:hunter:normal",
"value": 1
}, {
"kind": "counter_at_least",
"counter": "wins:shaman:normal",
"value": 1
}]
}
