"kind": "run_flag",
"flag": "final_boss_down"
}, {
"kind": "difficulty_at_least",
"tier": "pungent"
}]
}
rewards = Array[Dictionary]([{
"kind": "heirloom",
"id": "heir_ancestral_peeler",
"name": "Ancestral Peeler"
}])
