[gd_resource type="Resource" script_class="AchievementData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/achievement_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"ach_lone_bulb"
display_name = "Lone Bulb"
description = "Win a run on your own."
points = 20
condition_kind = &"all_of"
condition_params = {
"conditions": [{
"kind": "run_flag",
"flag": "final_boss_down"
}, {
"kind": "run_flag",
"flag": "solo"
}]
}
rewards = Array[Dictionary]([{
"kind": "title",
"id": "title_lone_bulb",
"name": "the Lone Bulb"
}])
