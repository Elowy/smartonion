[gd_resource type="Resource" script_class="AchievementData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/achievement_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"ach_first_tear"
display_name = "Salt in the Wound"
description = "Win a run on Tear-Jerker."
points = 30
condition_kind = &"all_of"
condition_params = {
"conditions": [{
"kind": "run_flag",
"flag": "final_boss_down"
}, {
"kind": "difficulty_at_least",
"tier": "tear_jerker"
}]
}
rewards = Array[Dictionary]([{
"kind": "legendary",
"id": "tearjerker"
}, {
"kind": "title",
"id": "title_tear_proof",
"name": "the Tear-Proof"
}])
