[gd_resource type="Resource" script_class="AchievementData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/achievement_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"ach_gremlin_roundup"
display_name = "Gremlin Roundup"
description = "Catch 3 Coin Gremlins in a single run."
points = 10
condition_kind = &"stat_at_least"
condition_params = {
"stat": "goblins_killed",
"value": 3
}
rewards = Array[Dictionary]([{
"kind": "heirloom",
"id": "heir_seed_pouch",
"name": "Lucky Seed Pouch"
}])
