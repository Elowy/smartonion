[gd_resource type="Resource" script_class="AchievementData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/achievement_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"ach_endless_40"
display_name = "Everbloom"
description = "Reach wave 40 in the Endless mode."
points = 25
condition_kind = &"all_of"
condition_params = {
"conditions": [{
"kind": "run_flag",
"flag": "endless"
}, {
"kind": "stat_at_least",
"stat": "wave",
"value": 40
}]
}
rewards = Array[Dictionary]([{
"kind": "title",
"id": "title_everlasting",
"name": "the Everlasting"
}, {
"kind": "cosmetic",
"id": "dye_gilded",
"name": "Gilded Gold"
}])
