[gd_resource type="Resource" script_class="AchievementData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/achievement_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"ach_clear_rogue"
display_name = "Quiet Harvest"
description = "Win a run with the Rogue in the party, on any difficulty. Opens Pungent for the Rogue and a Seasoning in The Onion Patch."
points = 10
condition_kind = &"all_of"
condition_params = {
"conditions": [{
"kind": "run_flag",
"flag": "final_boss_down"
}, {
"kind": "class_in_party",
"class_id": "rogue"
}]
}
rewards = Array[Dictionary]([{
"kind": "difficulty",
"id": "pungent",
"class_id": "rogue"
}])
