[gd_resource type="Resource" script_class="AchievementData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/achievement_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"ach_clear_hunter"
display_name = "Wild Harvest"
description = "Win a run with the Hunter in the party, on any difficulty. Opens Pungent for the Hunter and a Seasoning in The Onion Patch."
points = 10
condition_kind = &"all_of"
condition_params = {
"conditions": [{
"kind": "run_flag",
"flag": "final_boss_down"
}, {
"kind": "class_in_party",
"class_id": "hunter"
}]
}
rewards = Array[Dictionary]([{
"kind": "difficulty",
"id": "pungent",
"class_id": "hunter"
}])
