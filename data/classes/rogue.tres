[resource]
script = ExtResource("1_script")
id = &"rogue"
display_name = "Rogue"
description = "Strikes from the shadows. Critical hits fuel combo points."
role = "Fast critical striker"
armor_type = 1
primary_stat = &"agility"
base_stats = Dictionary[StringName, float]({
&"crit": 10.0,
&"dodge": 10.0,
&"stamina": -3.0,
&"armor": -1.0
})
main_hand = ExtResource("2_mh")
off_hand = ExtResource("3_oh")
proficiencies = Array[StringName]([&"dagger", &"sword", &"mace", &"bow", &"gun", &"dual_wield"])
resource_type = &"energy"
resource_color = Color(1.0, 0.9, 0.2, 1)
resources = Array[ExtResource("4_resdata")]([ExtResource("5_energy"), ExtResource("6_combo")])
abilities = Array[ExtResource("7_abilitydata")]([ExtResource("8_fan"), ExtResource("9_vanish")])
mastery = ExtResource("10_mastery")
mastery_text = "Lethal Venom: critical hits poison the target for 20% of the hit's damage (+1% per Mastery) over 4 sec, up to 5 stacks. Kills spread it nearby."
onion_color = Color(0.9, 0.92, 0.78, 1)
accent_color = Color(0.43, 0.5, 0.28, 1)
headgear = &"hood"
big_shoulders = false
