[gd_resource type="Resource" script_class="TalentTreeData" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/talents/talent_tree_data.gd" id="1_tree"]
[ext_resource type="Script" path="res://data/talents/talent_data.gd" id="2_talent"]

[sub_resource type="Resource" id="Resource_keen_companion"]
script = ExtResource("2_talent")
id = &"hunter_packlord_keen_companion"
