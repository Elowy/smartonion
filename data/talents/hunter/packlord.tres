description = "Your companion deals {pct}% more damage."
values = {
"pct": 4.0
}
kind = 0
tier = 1
column = 0
max_rank = 3
icon = &"damage_pct"
effects = Array[Dictionary]([{
"kind": "damage",
"pct": 4.0,
"source": "pet"
}])

