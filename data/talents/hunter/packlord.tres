[resource]
script = ExtResource("1_tree")
id = &"hunter_packlord"
class_id = &"hunter"
display_name = "Packlord"
index = 0
description = "Your companion, Hunt Signal and Beastbond."
icon = &"hunt_signal"
color = Color(0.78, 0.55, 0.25, 1)
talents = Array[ExtResource("2_talent")]([SubResource("Resource_keen_companion"), SubResource("Resource_bonded_vigor"), SubResource("Resource_feral_tempo"), SubResource("Resource_piercing_whistle"), SubResource("Resource_alpha_hide"), SubResource("Resource_open_wound"), SubResource("Resource_wild_kinship"), SubResource("Resource_kindred_instinct"), SubResource("Resource_pack_frenzy")])
