[sub_resource type="Resource" id="Resource_holy_shock"]
script = ExtResource("2_talent")
id = &"paladin_holy_holy_shock"
display_name = "Holy Shock"
description = "Every {interval} sec, Holy Shock heals the most wounded hero within {range} m below {below}% health (you included) for {heal}% of their maximum health – or, when nobody needs it, strikes the nearest enemy within {range} m for {pct}% weapon damage as Holy damage. Haste shortens the interval."
values = {
"below": 90.0,
"heal": 6.0,
"interval": 4.0,
"pct": 100.0,
"range": 8.0
}
kind = 2
tier = 5
column = 0
max_rank = 1
icon = &""
effects = Array[Dictionary]([{
"kind": "script",
"params": {
"heal_below": 90.0,
"heal_flat": 1.0,
"heal_max_hp_pct": 6.0,
"heal_sp_scale": 0.5,
"interval": 4.0,
"range": 8.0,
"retry": 0.25,
"sp_scale": 0.8,
"weapon_pct": 100.0
},
"script": "res://scenes/talents/paladin/holy_holy_shock.gd"
}])

[resource]
script = ExtResource("1_tree")
id = &"paladin_holy"
class_id = &"paladin"
display_name = "Holy"
index = 0
description = "Healing light, Holy Power and the allies at your side."
icon = &"word_of_glory"
color = Color(1, 0.88, 0.45, 1)
talents = Array[ExtResource("2_talent")]([SubResource("Resource_healing_light"), SubResource("Resource_aura_mastery"), SubResource("Resource_eternal_glory"), SubResource("Resource_unyielding_faith"), SubResource("Resource_lights_grace"), SubResource("Resource_lights_hammer"), SubResource("Resource_divine_guardian"), SubResource("Resource_purifying_power"), SubResource("Resource_holy_shock")])
