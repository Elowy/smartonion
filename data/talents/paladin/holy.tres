[gd_resource type="Resource" script_class="TalentTreeData" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/talents/talent_tree_data.gd" id="1_tree"]
[ext_resource type="Script" path="res://data/talents/talent_data.gd" id="2_talent"]

[sub_resource type="Resource" id="Resource_healing_light"]
script = ExtResource("2_talent")
id = &"paladin_holy_healing_light"
display_name = "Healing Light"
description = "Increases the healing of your Paladin abilities by {pct}%."
values = {
"pct": 4.0
}
kind = 0
tier = 1
column = 0
max_rank = 3
icon = &"healing_done"
effects = Array[Dictionary]([{
"kind": "stats",
"stats": {
"healing_done": 4.0
}
}])

[sub_resource type="Resource" id="Resource_aura_mastery"]
script = ExtResource("2_talent")
id = &"paladin_holy_aura_mastery"
display_name = "Aura Mastery"
description = "Increases your Mastery by {mastery}, and your Aura of Devotion reaches {radius} m further."
