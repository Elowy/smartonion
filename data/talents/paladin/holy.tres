[sub_resource type="Resource" id="Resource_lights_hammer"]
script = ExtResource("2_talent")
id = &"paladin_holy_lights_hammer"
display_name = "Light's Hammer"
description = "Consecration is hurled at the feet of the most wounded hero within {range} m who is below {below}% health (otherwise at your feet), and heroes standing in it heal {heal}% of their maximum health every {tick} sec."
values = {
"below": 80.0,
"heal": 1.0,
"range": 10.0,
"tick": 0.5
}
kind = 1
tier = 3
column = 1
max_rank = 1
ability = &"consecration"
icon = &"consecration"
effects = Array[Dictionary]([{
"kind": "ability",
"match": {
"id": "consecration"
},
"mods": {
"ally_range_add": 10.0,
"heal_max_hp_pct_add": 1.0
}
}])

[sub_resource type="Resource" id="Resource_divine_guardian"]
