[gd_resource type="Resource" script_class="TalentTreeData" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/talents/talent_tree_data.gd" id="1_tree"]
[ext_resource type="Script" path="res://data/talents/talent_data.gd" id="2_talent"]

[sub_resource type="Resource" id="Resource_redoubt"]
script = ExtResource("2_talent")
id = &"paladin_protection_redoubt"
display_name = "Redoubt"
description = "While you hold a shield, your chance to block is increased by {block}% and your blocks absorb {value}% more damage."
values = {
"block": 3.0,
"value": 10.0
}
kind = 0
tier = 1
column = 0
max_rank = 3
icon = &"block_value"
effects = Array[Dictionary]([{
"kind": "stats",
"requires": {
"weapon": "shield"
},
"stats": {
"block_chance": 3.0,
"block_value": 10.0
}
}])

