[resource]
script = ExtResource("1_tree")
id = &"paladin_protection"
class_id = &"paladin"
display_name = "Protection"
index = 1
description = "Shield, holy ground and taunts: the line no enemy crosses."
icon = &"avengers_shield"
color = Color(0.55, 0.72, 0.95, 1)
talents = Array[ExtResource("2_talent")]([SubResource("Resource_redoubt"), SubResource("Resource_stoicism"), SubResource("Resource_consecrated_ground"), SubResource("Resource_guarded_by_the_light"), SubResource("Resource_ardent_defender"), SubResource("Resource_righteous_fury"), SubResource("Resource_shield_of_the_templar"), SubResource("Resource_reckoning"), SubResource("Resource_holy_shield")])
