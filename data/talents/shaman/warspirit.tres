[sub_resource type="Resource" id="Resource_gale_strike"]
script = ExtResource("2_talent")
id = &"shaman_warspirit_gale_strike"
display_name = "Gale Strike"
description = "Every {every_fixed}th weapon attack calls down {strikes_fixed} lightning strikes on the target, each a Nature hit that also builds Surge."
values = {
"every_fixed": 5.0,
"strikes_fixed": 2.0
}
kind = 2
tier = 5
max_rank = 1
effects = Array[Dictionary]([{
"kind": "script",
"params": {
"damage": 5.0,
"every": 5,
"intellect_scale": 0.8,
"range": 6.0,
"spell_power_scale": 1.2,
"strike_delay": 0.2,
"strikes": 2,
"surge_per_strike": 3.0
},
"script": "res://scenes/talents/shaman/warspirit_gale_strike.gd"
}])

[resource]
script = ExtResource("1_tree")
id = &"shaman_warspirit"
class_id = &"shaman"
display_name = "Warspirit"
index = 1
description = "Fist weapons, Dual Wield, Magma Lash and Gale Strike."
icon = &"magma_lash"
color = Color(0.95, 0.55, 0.2, 1)
talents = Array[ExtResource("2_talent")]([SubResource("Resource_twinned_spirits"), SubResource("Resource_hardened_knuckles"), SubResource("Resource_mirrored_strikes"), SubResource("Resource_spirit_pulse"), SubResource("Resource_flame_tempering"), SubResource("Resource_molten_trail"), SubResource("Resource_crackling_blows"), SubResource("Resource_howling_chorus"), SubResource("Resource_gale_strike")])
