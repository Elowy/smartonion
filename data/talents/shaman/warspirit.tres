"cd": 8.0,
"pct": 8.0
}
tier = 3
max_rank = 2
icon = &"magma_lash"
effects = Array[Dictionary]([{
"kind": "ability",
"match": {
"id": "magma_lash"
},
"mods": {
"cooldown_pct": -8.0,
"power_pct": 8.0
}
}])

[sub_resource type="Resource" id="Resource_molten_trail"]
script = ExtResource("2_talent")
id = &"shaman_warspirit_molten_trail"
display_name = "Molten Trail"
description = "Magma Lash leaves molten ground at the target for {duration} sec: enemies standing in it take {pct}% of the lash's damage every 0.5 sec."
values = {
"duration": 3.0,
"pct": 15.0
}
kind = 1
tier = 3
column = 1
max_rank = 1
ability = &"magma_lash"
icon = &"magma_lash"
effects = Array[Dictionary]([{
"kind": "ability",
"match": {
"id": "magma_lash"
},
"mods": {
"ground_duration_add": 3.0,
"ground_pct_add": 15.0
}
}])

[sub_resource type="Resource" id="Resource_crackling_blows"]
script = ExtResource("2_talent")
id = &"shaman_warspirit_crackling_blows"
display_name = "Crackling Blows"
description = "Your weapon hits have a {chance}% chance to also shock the target for {pct_fixed}% of the hit's damage as Nature damage."
