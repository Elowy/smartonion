[gd_resource type="Resource" script_class="TalentTreeData" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/talents/talent_tree_data.gd" id="1_tree"]
[ext_resource type="Script" path="res://data/talents/talent_data.gd" id="2_talent"]

[sub_resource type="Resource" id="Resource_twinned_spirits"]
script = ExtResource("2_talent")
id = &"shaman_warspirit_twinned_spirits"
display_name = "Twinned Spirits"
description = "You can wield a one-handed weapon in each hand (Dual Wield). While dual wielding, your Haste is increased by {haste}%."
values = {
"haste": 3.0
}
icon = &"haste"
effects = Array[Dictionary]([{
"grant": "dual_wield",
"kind": "proficiency"
}, {
"kind": "stats",
"requires": {
"weapon": "dual_wield"
},
"stats": {
"haste": 3.0
}
}])

[sub_resource type="Resource" id="Resource_hardened_knuckles"]
script = ExtResource("2_talent")
id = &"shaman_warspirit_hardened_knuckles"
display_name = "Hardened Knuckles"
description = "Your weapon hits deal {pct}% more damage."
values = {
"pct": 4.0
}
column = 1
icon = &"damage_pct"
effects = Array[Dictionary]([{
"kind": "damage",
"pct": 4.0,
"source": "weapon"
}])

[sub_resource type="Resource" id="Resource_mirrored_strikes"]
script = ExtResource("2_talent")
id = &"shaman_warspirit_mirrored_strikes"
display_name = "Mirrored Strikes"
description = "While dual wielding, your weapon hits have a {chance}% chance to strike again at once."
values = {
"chance": 4.0
}
tier = 2
prerequisite = &"shaman_warspirit_twinned_spirits"
icon = &"extra_attack"
effects = Array[Dictionary]([{
"kind": "stats",
"requires": {
"weapon": "dual_wield"
},
"stats": {
"extra_attack": 4.0
}
}])

[sub_resource type="Resource" id="Resource_spirit_pulse"]
script = ExtResource("2_talent")
id = &"shaman_warspirit_spirit_pulse"
display_name = "Spirit Pulse"
description = "Your weapon hits and ability casts build {surge} more Surge."
values = {
"surge": 1.0
}
tier = 2
column = 1
icon = &"resource_regen"
effects = Array[Dictionary]([{
"gain_on_hit_add": 1.0,
"kind": "resource",
"resource": "surge"
}])

[sub_resource type="Resource" id="Resource_flame_tempering"]
script = ExtResource("2_talent")
id = &"shaman_warspirit_flame_tempering"
display_name = "Flame Tempering"
description = "Magma Lash deals {pct}% more damage and recharges {cd}% faster."
