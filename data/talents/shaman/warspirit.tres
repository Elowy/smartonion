effects = Array[Dictionary]([{
"kind": "proc",
"proc": {
"chance": 15.0,
"effect": "bolt",
"hit_pct": 60.0,
"label": "",
"school": "nature",
"trigger": "on_hit"
},
"scale": ["chance"]
}])

[sub_resource type="Resource" id="Resource_howling_chorus"]
