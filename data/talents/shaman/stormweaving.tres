[resource]
script = ExtResource("1_tree")
id = &"shaman_stormweaving"
class_id = &"shaman"
display_name = "Stormweaving"
description = "Lightning and fire spells, Storm Echo and Surge."
icon = &"thunderbolt"
color = Color(0.45, 0.75, 1, 1)
talents = Array[ExtResource("2_talent")]([SubResource("Resource_livewire"), SubResource("Resource_kindled_spark"), SubResource("Resource_charged_mind"), SubResource("Resource_stormcharged"), SubResource("Resource_static_veins"), SubResource("Resource_rebounding_arc"), SubResource("Resource_resounding_echo"), SubResource("Resource_quickening_storm"), SubResource("Resource_elemental_surge")])
