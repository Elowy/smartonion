[gd_resource type="Resource" script_class="TalentTreeData" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/talents/talent_tree_data.gd" id="1_tree"]
[ext_resource type="Script" path="res://data/talents/talent_data.gd" id="2_talent"]

[sub_resource type="Resource" id="Resource_livewire"]
script = ExtResource("2_talent")
id = &"shaman_stormweaving_livewire"
display_name = "Livewire"
description = "Increases your Nature damage by {pct}%: Forking Bolt, Thunderbolt, Stormburst, Rumbling Earth, Gale Strike and your wolves."
values = {
"pct": 3.0
}
icon = &"nature_damage"
effects = Array[Dictionary]([{
"kind": "damage",
"pct": 3.0,
"school": "nature"
}])

