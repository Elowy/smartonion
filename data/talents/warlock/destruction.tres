talents = Array[ExtResource("2_talent")]([SubResource("Resource_devastation"), SubResource("Resource_emberstorm"), SubResource("Resource_fire_and_brimstone"), SubResource("Resource_aftermath"), SubResource("Resource_soul_leech"), SubResource("Resource_shadowburn"), SubResource("Resource_ruin"), SubResource("Resource_burning_embers"), SubResource("Resource_conflagrate")])
