color = Color(0.45, 0.95, 0.25, 1)
talents = Array[ExtResource("2_talent")]([SubResource("Resource_demonic_embrace"), SubResource("Resource_improved_imp"), SubResource("Resource_unholy_power"), SubResource("Resource_soul_harvest"), SubResource("Resource_demonic_aegis"), SubResource("Resource_wild_imps"), SubResource("Resource_master_demonologist"), SubResource("Resource_fel_synergy"), SubResource("Resource_soul_link")])
