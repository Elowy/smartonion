[sub_resource type="Resource" id="Resource_curse_of_agony"]
script = ExtResource("2_talent")
id = &"warlock_affliction_curse_of_agony"
display_name = "Curse of Agony"
description = "Your weapon hits curse their target with Agony: {pct}% of the hit's damage as Shadow damage over {duration_fixed} sec. Further hits add to the curse."
values = {
"duration_fixed": 6.0,
"pct": 5.0
}
kind = 0
tier = 1
column = 0
max_rank = 3
icon = &"corruption"
effects = Array[Dictionary]([{
"kind": "ability",
"match": {
"id": "warlock_afflictions"
},
"mods": {
"agony_pct_add": 5.0
}
}])

