[sub_resource type="Resource" id="Resource_unstable_affliction"]
script = ExtResource("2_talent")
id = &"warlock_affliction_unstable_affliction"
display_name = "Unstable Affliction"
description = "When an enemy suffering from any of your afflictions dies – no matter who killed it – it bursts with unstable shadow: Shadow damage to every enemy within {radius} m, stunning them for {stun} sec (each enemy at most once every {icd} sec)."
values = {
"icd": 4.0,
"radius": 3.0,
"stun": 1.0
}
kind = 2
tier = 5
column = 0
max_rank = 1
icon = &"seed_of_corruption"
effects = Array[Dictionary]([{
"kind": "script",
"params": {
"damage": 2.0,
"intellect_scale": 0.35,
"max_per_tick": 4,
"queue_cap": 32,
"radius": 3.0,
"spell_power_scale": 0.5,
"stun": 1.0,
"stun_icd": 4.0
},
"script": "res://scenes/talents/warlock/affliction_unstable_affliction.gd"
}])

[resource]
script = ExtResource("1_tree")
id = &"warlock_affliction"
