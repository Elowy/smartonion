"ability": "vanish",
"effect": "resource",
"label": "",
"resource": "combo_points",
"trigger": "on_cast",
"value": 1
},
"scale": ["value"]
}, {
"kind": "ability",
"match": {
"id": "vanish"
},
"mods": {
"auto_offense_add": 1,
"forced_crits_add": 1
}
}])

