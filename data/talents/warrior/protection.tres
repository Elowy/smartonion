},
"scale": ["chance"]
}, {
"kind": "proc",
"proc": {
"chance": 15.0,
"count": 1,
"effect": "extra_attack",
"icd": 0.5,
"label": "",
"trigger": "on_dodge"
},
"scale": ["chance"]
}])

[sub_resource type="Resource" id="Resource_defiance"]
script = ExtResource("2_talent")
id = &"warrior_protection_defiance"
display_name = "Defiance"
description = "Taking damage generates {rage} more Rage, and your Rage decays {decay} less per second out of combat."
values = {
"decay": 1.0,
"rage": 2.0
}
kind = 0
tier = 2
column = 1
max_rank = 3
icon = &"resource_regen"
effects = Array[Dictionary]([{
"decay_per_second_add": -1.0,
"gain_on_damage_taken_add": 2.0,
"kind": "resource",
"resource": "rage"
}])

[sub_resource type="Resource" id="Resource_vitality"]
script = ExtResource("2_talent")
id = &"warrior_protection_vitality"
