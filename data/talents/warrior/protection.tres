"pct": 5.0,
"slow": 10.0,
"slow_duration_fixed": 1.5
}
kind = 0
tier = 4
column = 1
max_rank = 3
icon = &"thunder_clap"
effects = Array[Dictionary]([{
"kind": "ability",
"match": {
"ids": ["whirlwind", "thunder_clap"]
},
"mods": {
"power_pct": 5.0
}
}, {
"kind": "ability",
"match": {
"id": "whirlwind"
},
"mods": {
"slow_add": 10.0
}
}])

[sub_resource type="Resource" id="Resource_unbreakable"]
script = ExtResource("2_talent")
id = &"warrior_protection_unbreakable"
display_name = "Unbreakable"
description = "Once per wave, a hit that would bring you down leaves you standing instead: for {duration} sec your maximum health is increased by {self_pct}% and you are healed by that much, and allies within {radius} m gain {ally_pct}% maximum health the same way."
values = {
"ally_pct": 15.0,
"duration": 10.0,
"radius": 8.0,
"self_pct": 30.0
}
kind = 2
tier = 5
column = 0
max_rank = 1
icon = &""
effects = Array[Dictionary]([{
"kind": "script",
"params": {
"ally_max_hp_pct": 15.0,
"ally_radius": 8.0,
"duration": 10.0,
"invulnerable": 1.0,
"max_hp_pct": 30.0
},
"script": "res://scenes/talents/warrior/protection_unbreakable.gd"
}])

[resource]
script = ExtResource("1_tree")
id = &"warrior_protection"
class_id = &"warrior"
display_name = "Protection"
index = 2
description = "Shield, armour and taunts: the wall your allies stand behind."
icon = &"shield_wall"
color = Color(0.45, 0.6, 0.85, 1)
talents = Array[ExtResource("2_talent")]([SubResource("Resource_toughness"), SubResource("Resource_shield_specialization"), SubResource("Resource_revenge"), SubResource("Resource_defiance"), SubResource("Resource_vitality"), SubResource("Resource_challenging_charge"), SubResource("Resource_shield_mastery"), SubResource("Resource_blood_and_thunder"), SubResource("Resource_unbreakable")])
