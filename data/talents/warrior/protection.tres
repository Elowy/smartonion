tier = 1
column = 0
max_rank = 3
icon = &"armor"
effects = Array[Dictionary]([{
"kind": "stats",
"stats": {
"armor": 2.0
}
}])

[sub_resource type="Resource" id="Resource_shield_specialization"]
script = ExtResource("2_talent")
id = &"warrior_protection_shield_specialization"
display_name = "Shield Specialization"
description = "While you wield a shield, your chance to block is increased by {block}% and your blocks absorb {value}% more damage."
values = {
"block": 3.0,
"value": 10.0
}
kind = 0
tier = 1
column = 1
max_rank = 3
icon = &"block_value"
effects = Array[Dictionary]([{
"kind": "stats",
"requires": {
"weapon": "shield"
},
"stats": {
"block_chance": 3.0,
"block_value": 10.0
}
}])

[sub_resource type="Resource" id="Resource_revenge"]
script = ExtResource("2_talent")
id = &"warrior_protection_revenge"
display_name = "Revenge"
description = "Increases your chance to parry melee attacks by {parry}%. When you block or dodge an attack, you have a {chance}% chance to strike back at once."
