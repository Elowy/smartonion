"pct": -4.0,
"requires": {
"weapon": "shield"
}
}])

[sub_resource type="Resource" id="Resource_blood_and_thunder"]
script = ExtResource("2_talent")
id = &"warrior_protection_blood_and_thunder"
display_name = "Blood and Thunder"
description = "Whirlwind and Thunder Clap are {pct}% stronger, and Whirlwind slows the enemies it hits by {slow}% for {slow_duration_fixed} sec."
