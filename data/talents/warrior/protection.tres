"strength": 1.0
}
}])

[sub_resource type="Resource" id="Resource_challenging_charge"]
script = ExtResource("2_talent")
id = &"warrior_protection_challenging_charge"
display_name = "Challenging Charge"
description = "Enemies stunned by Charge are taunted to you for {taunt} sec after the stun, and you gain an absorb shield of {shield}% of your maximum health per enemy stunned (up to {max}%) for {duration} sec."
values = {
"duration": 5.0,
"max": 15.0,
"shield": 3.0,
"taunt": 4.0
}
kind = 1
tier = 3
column = 1
max_rank = 1
ability = &"charge"
icon = &"charge"
effects = Array[Dictionary]([{
"kind": "ability",
"match": {
"id": "charge"
},
"mods": {
"shield_per_enemy_add": 3.0,
"taunt_add": 4.0
}
}])

[sub_resource type="Resource" id="Resource_shield_mastery"]
script = ExtResource("2_talent")
id = &"warrior_protection_shield_mastery"
display_name = "Shield Mastery"
description = "While you wield a shield, you take {pct}% less damage."
