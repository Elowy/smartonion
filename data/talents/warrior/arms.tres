talents = Array[ExtResource("2_talent")]([SubResource("Resource_deflection"), SubResource("Resource_tactical_mastery"), SubResource("Resource_improved_charge"), SubResource("Resource_deep_wounds"), SubResource("Resource_two_handed_specialization"), SubResource("Resource_sweeping_blows"), SubResource("Resource_impale"), SubResource("Resource_sudden_death"), SubResource("Resource_mortal_strike")])
