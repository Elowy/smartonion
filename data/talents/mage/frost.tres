talents = Array[ExtResource("2_talent")]([SubResource("Resource_piercing_ice"), SubResource("Resource_ice_armor"), SubResource("Resource_improved_blizzard"), SubResource("Resource_winters_chill"), SubResource("Resource_arctic_winds"), SubResource("Resource_deep_freeze"), SubResource("Resource_flash_freeze"), SubResource("Resource_chilled_to_the_bone"), SubResource("Resource_ice_lance")])
