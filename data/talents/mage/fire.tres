[resource]
script = ExtResource("1_tree")
id = &"mage_fire"
class_id = &"mage"
display_name = "Pyrelore"
index = 1
description = "Critical strikes, Ignite and spreading flames."
icon = &"fireball"
color = Color(1, 0.48, 0.12, 1)
talents = Array[ExtResource("2_talent")]([SubResource("Resource_critical_mass"), SubResource("Resource_fire_power"), SubResource("Resource_empowered_fire"), SubResource("Resource_incineration"), SubResource("Resource_playing_with_fire"), SubResource("Resource_living_bomb"), SubResource("Resource_burnout"), SubResource("Resource_molten_fury"), SubResource("Resource_combustion")])
