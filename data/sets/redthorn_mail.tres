[gd_resource type="Resource" script_class="SetData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/sets/set_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"redthorn_mail"
display_name = "Redthorn Mail"
class_id = &""
armor_type = 2
piece_ids = Array[StringName]([&"set_redthorn_head", &"set_redthorn_shoulders", &"set_redthorn_chest", &"set_redthorn_hands", &"set_redthorn_legs"])
bonuses = Array[Dictionary]([{
"effects": [{"kind": "stats", "stats": {"slayer": 12.0}}],
"pieces": 2,
"text": "Increases your damage against elites and bosses by 12%."
}, {
"effects": [{"kind": "proc", "proc": {"trigger": "on_kill", "effect": "buff", "duration": 6.0, "max_stacks": 6, "stats": {"damage_pct": 2.0}}}],
"pieces": 4,
"text": "Each kill grants +2% damage for 6 sec. Stacks up to 6 times."
}])
