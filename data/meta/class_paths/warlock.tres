[gd_resource type="Resource" script_class="ClassPathData" load_steps=4 format=3]

[ext_resource type="Script" path="res://data/class_path_data.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/weapons/wand.tres" id="2_mh"]
[ext_resource type="Resource" path="res://data/weapons/orb.tres" id="3_oh"]

[resource]
script = ExtResource("1_script")
class_id = &"warlock"
deck_abilities = Array[StringName]([&"summon_infernal", &"fear"])
capstone_trees = Array[StringName]([&"warlock_demonology", &"warlock_affliction", &"warlock_destruction"])
alt_main_hand = ExtResource("2_mh")
alt_off_hand = ExtResource("3_oh")
gift_heirloom = &"heir_garlic_braid"
gift_heirloom_name = "Garlic Braid"
cosmetics = Array[Dictionary]([{
"slot": "tabard",
"id": "cos_warlock_tabard",
"name": "Hexweave Tabard"
}, {
"slot": "hat",
"id": "cos_warlock_hat",
"name": "Imp-Horn Hood"
}, {
"slot": "glow",
"id": "cos_warlock_glow",
"name": "Violet Embers"
}])
title_id = &"title_warlock"
title_name = "the Rotten Root"
