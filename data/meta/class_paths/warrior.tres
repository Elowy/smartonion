[gd_resource type="Resource" script_class="ClassPathData" load_steps=3 format=3]

[ext_resource type="Script" path="res://data/class_path_data.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/weapons/two_hand_sword.tres" id="2_mh"]

[resource]
script = ExtResource("1_script")
class_id = &"warrior"
deck_abilities = Array[StringName]([&"heroic_leap", &"bladestorm"])
capstone_trees = Array[StringName]([&"warrior_fury", &"warrior_protection", &"warrior_arms"])
alt_main_hand = ExtResource("2_mh")
gift_heirloom = &"heir_apron"
gift_heirloom_name = "Grandmother's Apron"
cosmetics = Array[Dictionary]([{
"slot": "tabard",
"id": "cos_warrior_tabard",
"name": "Ironhide Tabard"
}, {
"slot": "hat",
"id": "cos_warrior_hat",
"name": "Bullhorn Helm"
}, {
"slot": "glow",
"id": "cos_warrior_glow",
"name": "Ember Glow"
}])
title_id = &"title_warrior"
title_name = "the Unbreakable"
